<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing: xUnit v3 on Microsoft Testing Platform, as in pdn-soundmodem, where these
         tests were written. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.2.0" />
    <!-- The Watterson HF channel and the impulse noise the masks are measured through. -->
    <PackageVersion Include="M0LTE.HfChannel" Version="0.1.0" />

    <!-- Dependencies. M0LTE.Ofdm is here for its complex type Cf, which the equaliser and the
         channel model share. -->
    <PackageVersion Include="M0LTE.Dsp" Version="0.2.2" />
    <PackageVersion Include="M0LTE.Fec" Version="0.3.0" />
    <PackageVersion Include="M0LTE.Ofdm" Version="0.1.0" />

    <!-- Public-API lock -->
    <PackageVersion Include="PublicApiGenerator" Version="11.4.5" />
  </ItemGroup>

</Project>
